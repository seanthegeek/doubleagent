# the base file with these changes: each hunk follows the lines it quotes
@@ after
 doubleagent {VERSION} starting on {HOST} ({SYSTEM}) mode=image root={WORK}\root run_as={ACCOUNT} admin={ADMIN}
-max_file_size=1MB full=0 no_secrets=0 no_docker=0 env_scan_home=0 env_scan_max_size=1MB no_preserve_atime=0
+max_file_size=1MB full=0 no_secrets=1 no_docker=0 env_scan_home=0 env_scan_max_size=1MB no_preserve_atime=0
@@ after
   [agent-zero] {WORK}\root\var\lib\docker\volumes\a0_usr\_data
+  [dify] {WORK}\root\var\lib\docker\volumes\docker_dify_agent_local_sandbox_home\_data
+  [dify] {WORK}\root\var\lib\docker\volumes\docker_dify_agent_local_sandbox_workspace\_data
+  [hermes] {WORK}\root\var\lib\docker\volumes\hermes_home\_data
+  [langflow] {WORK}\root\var\lib\docker\volumes\langflow_langflow-data\_data
+  [ollama] {WORK}\root\var\lib\docker\volumes\local-deep-research_ollama_data\_data
+  [n8n] {WORK}\root\var\lib\docker\volumes\n8n_data\_data
+  [n8n] {WORK}\root\var\lib\docker\volumes\n8n_n8n-data\_data
+  [ollama] {WORK}\root\var\lib\docker\volumes\ollama\_data
@@ after
   [claude-code] {WORK}\root\var\lib\docker\volumes\openclaw_home\_data
+  [openhands] {WORK}\root\var\lib\docker\volumes\openhands_state\_data
