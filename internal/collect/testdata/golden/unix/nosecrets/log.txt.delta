# the default case's file with these changes: each hunk follows the line it names
@@ after doubleagent {VERSION} starting on {HOST} ({SYSTEM}) mode=image root={WORK}/root uid={UID}
-hash=crypto/sha256 max_file_size=1MB full=0 no_secrets=0 no_docker=0 env_scan_home=0 env_scan_max_size=1MB no_preserve_atime=0
+hash=crypto/sha256 max_file_size=1MB full=0 no_secrets=1 no_docker=0 env_scan_home=0 env_scan_max_size=1MB no_preserve_atime=0
