# Keep the PowerShell collector CRLF on checkout so it opens cleanly in
# Notepad and signtool; everything else is LF.
* text=auto
*.ps1 text eol=crlf
*.sh text eol=lf
# The output examples regenerator rewrites only LF documents.
analyzer/docs/output.md text eol=lf
*.go text eol=lf
# The vendored modules are third-party source a reviewer reads as generated.
vendor/** linguist-generated=true
