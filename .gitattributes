# Keep the PowerShell scripts (the lab's Windows guest scripts) CRLF on
# checkout, the line ending Windows tools expect; everything else is LF.
* text=auto
*.ps1 text eol=crlf
*.sh text eol=lf
*.go text eol=lf
# The vendored modules are third-party source a reviewer reads as generated.
vendor/** linguist-generated=true

# The embedded catalog is compared byte for byte with `collect --list`.
internal/catalog/catalog.txt text eol=lf

# SQLite test databases and their sidecars are bytes, never text.
internal/sqlitefile/testdata/*.db binary
internal/sqlitefile/testdata/*.db-wal binary
internal/sqlitefile/testdata/*.db-journal binary

# The zstd test frames are hashed and decoded byte for byte.
internal/zstdframe/testdata/frames/*.zst binary

# Recorded test outputs and the inputs the Go tests read are compared byte
# for byte.
internal/input/testdata/*_dumps.txt text eol=lf
internal/**/testdata/**/*.tar.gz binary
internal/**/testdata/**/*.tar.bz2 binary
internal/**/testdata/**/*.zip binary

# Expected output and its inputs are compared byte for byte, so they stay LF
# on a Windows checkout.
internal/analyze/testdata/golden/** text eol=lf
internal/analyze/testdata/golden-inputs/** text eol=lf
internal/analyze/testdata/golden/**/*.gz binary
internal/walk/testdata/edge_* text eol=lf

# The expected output of collect and its other test data are compared byte
# for byte.
internal/collect/testdata/** text eol=lf
